# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string. Include the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/langchain

# Auth.js signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string

# ── LangGraph server ────────────────────────────────────────────────────────
# Server-side only. The browser talks to /api/langgraph, never to this URL.
# Use `localhost`, not 127.0.0.1: the LangGraph dev server binds to IPv6 (::1).
LANGGRAPH_URL=http://localhost:4000

# Optional: only if the LangGraph server is behind an API key.
# LANGGRAPH_API_KEY=

# Optional: canonical app URL (Auth.js otherwise trusts the request host).
# AUTH_URL=http://localhost:3000

# ── One-time admin seed (used by `npm run seed:admin`) ──────────────────────
# Remove these after creating the admin, or keep them in a secret manager.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=Administrator
